# Required: OpenRouter key for /api/chat. Keep this file out of git.
OPEN_ROUTER_SECRET=sk-or-v1-...

# Free-model failover chain (50 requests/day without credits).
OPEN_ROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free
OPEN_ROUTER_AUDIT_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free,nvidia/nemotron-3.5-lightning:free

# Where the built SPA lives. Compose sets this to /app/frontend-dist.
FRONTEND_DIST=../Telos-Frontend/telos/dist

# Optional same-origin allowlist for /api/chat.
ALLOWED_ORIGINS=

# Privy app id. Access tokens are verified against the public JWKS, no key needed.
PRIVY_APP_ID=

# OpenRouter management key. Creates one sub-key per agent, each capped at
# OPEN_ROUTER_AGENT_LIMIT_USD per month. Never sent to the browser.
OPEN_ROUTER_MANAGEMENT_KEY=
OPEN_ROUTER_AGENT_LIMIT_USD=5

# Admin token for POST /admin/scheduled-strategies (send as x-admin-token header).
ADMIN_API_TOKEN=
